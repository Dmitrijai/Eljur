rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /appStates/{stateId} {
      // Secured: only authenticated users can read/write the central state.
      // A more granular schema (users, grades collections) would be needed for RBAC.
      allow read, write: if request.auth != null;
    }
  }
}
